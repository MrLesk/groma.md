@@ -48 +119,15 @@ module.exports = grammar(CPP, {
-    _top_level_item: ($, original) => choice(original, $.input_group),
+    conditional_method: $ => seq(
+      choice(preprocessor("ifdef"), preprocessor("ifndef")), $.identifier,
+      $._conditional_constructor_header,
+      preprocessor("else"), $._conditional_constructor_header, preprocessor("endif"),
+      repeat($._block_item), "}",
+    ),
+    _conditional_constructor_header: $ => seq($.function_declarator, "{"),
+
+    _block_item: ($, original) => choice(original, alias($.conditional_if_statement, $.preproc_if)),
+    conditional_if_statement: $ => prec.right(seq(
+      choice(preprocessor("ifdef"), preprocessor("ifndef")), $.identifier,
+      "if", $.condition_clause, "{",
+      preprocessor("else"), "if", $.condition_clause, "{", preprocessor("endif"),
+      repeat($._block_item), "}", optional($.else_clause),
+    )),
@@ -54 +139 @@ module.exports = grammar(CPP, {
-      prec.right(seq("input", "group", field("name", $.string_literal), optional(";"))),
+      prec.right(seq("input", "group", field("name", choice($.string_literal, $.identifier)), optional(";"))),
@@ -69 +154,3 @@ module.exports = grammar(CPP, {
-    primitive_type: _ =>
+    _mql_shared_type: _ => choice("datetime", "color"),
+
+    primitive_type: $ => choice($._mql_shared_type,
@@ -91,2 +177,0 @@ module.exports = grammar(CPP, {
-        "datetime",
-        "color",
@@ -97 +182 @@ module.exports = grammar(CPP, {
-      )),
+      ))),
@@ -118,0 +204,2 @@ module.exports = grammar(CPP, {
+      $.typename_expression,
+      $.integer_conversion_expression,
@@ -120,0 +208,16 @@ module.exports = grammar(CPP, {
+    // MQL5 typename(T) returns a type name. It is not a runtime invocation.
+    typename_expression: $ => prec(16, seq("typename", "(", $.type_descriptor, ")")),
+
+    // C++ treats long/short as sized types, so its primitive-call rule misses them.
+    integer_conversion_expression: $ => seq(choice("long", "short"), $.argument_list),
+
+    // Conditional array entries remain syntax, never a chosen preprocessing branch.
+    initializer_list: $ => seq("{", repeat($._initializer_item),
+      optional($._initializer_value), "}"),
+
+    _initializer_value: $ => choice($.initializer_pair, $.expression, $.initializer_list),
+    _initializer_item: $ => choice(seq($._initializer_value, ","),
+      alias($.conditional_initializer, $.preproc_if)),
+
+    conditional_initializer: $ => conditionalEntries($, $._initializer_item, $._initializer_value),
+
@@ -142 +245 @@ module.exports = grammar(CPP, {
-      original,
+      original, $.conditional_declaration_prefix, alias($.conditional_method, $.preproc_if),
@@ -146,0 +250,13 @@ module.exports = grammar(CPP, {
+
+// Retain both raw branches, with the same conditional-node alias in either list.
+function conditionalEntries($, item, value) {
+  return seq(
+    choice(
+      seq(choice(/#[ \t]*ifdef/, /#[ \t]*ifndef/), field("name", $.identifier)),
+      seq(/#[ \t]*if/, field("condition", $._preproc_expression), "\n"),
+    ),
+    repeat(item), optional(value),
+    optional(seq(/#[ \t]*else/, repeat(item), optional(value))),
+    /#[ \t]*endif/,
+  )
+}
