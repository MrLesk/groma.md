@@ -44,0 +51,57 @@ module.exports = grammar(CPP, {
+    // Quoted replacement tokens keep comment markers literal in any directive position.
+    // Continued definitions also retain their raw block/line comments.
+    preproc_arg: _ => {
+      const quoted = /"(?:\\(?:\r?\n|[^\r\n])|[^"\\\r\n])*"|'(?:\\(?:\r?\n|[^\r\n])|[^'\\\r\n])*'/;
+      return token(prec(-1, seq(choice(quoted, /[^\s"']/), repeat(choice(
+        quoted, /[^/"'\n]/, seq('/', choice(quoted, /[^*/"']/)),
+        /\\[ \t]*\/\/[^\r\n]*\r?\n/, /\\\r?\n/,
+        /\/\*[^*\n]*\*+([^/*\n][^*\n]*\*+)*\//,
+      )))));
+    },
+
+    // Shared C++ headers can implement types which are MQL5 primitive names.
+    emulated_constructor_declarator: $ => seq(field("declarator", alias($._mql_shared_type, $.identifier)), $._function_declarator_seq),
+    constructor_or_destructor_declaration: ($, original) => choice(original, seq(
+      field("declarator", alias($.emulated_constructor_declarator, $.function_declarator)), ";")),
+    constructor_or_destructor_definition: ($, original) => choice(original, seq(
+      field("declarator", alias($.emulated_constructor_declarator, $.function_declarator)), field("body", $.compound_statement))),
+
+    _class_declaration_item: ($, original) => choice(original, seq(field("name", $._class_name),
+      alias($.conditional_base_clause, $.preproc_if), field("body", $.field_declaration_list))),
+    conditional_base_clause: $ => seq(choice(preprocessor("ifdef"), preprocessor("ifndef")), $.identifier,
+      $.base_class_clause, preprocessor("endif")),
+
+    // Paired standard-library maps are retained as source, never expanded into OnEvent.
+    event_map: $ => seq("EVENT_MAP_BEGIN", "(", $.identifier, ")",
+      repeat($._event_map_item), "EVENT_MAP_END", "(", $.identifier, ")"),
+    _event_map_item: $ => choice($.event_map_handler,
+      seq("{", repeat($._event_map_item), "}"),
+      prec.right(seq("if", $.condition_clause, $._event_map_item, optional(seq("else", $._event_map_item))))),
+    event_map_handler: $ => seq(choice("ON_EVENT", "ON_INDEXED_EVENT"), $.argument_list),
+
+    // MQL5 permits void before a constructor, including its initializer list.
+    function_definition: ($, original) => choice(original, seq(
+      $._declaration_specifiers,
+      field("declarator", $.function_declarator),
+      $.field_initializer_list,
+      field("body", $.compound_statement),
+    )),
+    inline_method_definition: ($, original) => choice(original, prec(1, seq(
+      $._declaration_specifiers,
+      field("declarator", alias($.function_field_declarator, $.function_declarator)),
+      $.field_initializer_list,
+      field("body", $.compound_statement),
+    ))),
+
+    _field_declarator: ($, original) => choice(original, $.destructor_name),
+
+    // MQL5 this is the current object variable, not C++'s pointer value.
+    _assignment_left_expression: ($, original) => choice(original, $.this),
+
+    parameter_list: $ => seq("(", repeat($._parameter_item), optional($._parameter_value), ")"),
+    _parameter_value: $ => choice($.parameter_declaration, $.optional_parameter_declaration,
+      $.variadic_parameter_declaration, "..."),
+    _parameter_item: $ => choice(seq($._parameter_value, ","),
+      alias($.conditional_parameters, $.preproc_if)),
+    conditional_parameters: $ => conditionalEntries($, $._parameter_item, $._parameter_value),
+
@@ -46 +109,9 @@ module.exports = grammar(CPP, {
