{
  "name": "@groma/scanner-typescript",
  "version": "0.2.5",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@groma/scanner": "workspace:*",
    "typescript": "7.1.0-beta"
  },
  "description": "TypeScript source and call evidence using the native TypeScript SDK.",
  "groma": {
    "scanner": {
      "id": "typescript",
      "entry": "./src/index.ts",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ],
      "discovery": {
        "technologies": [
          "typescript"
        ],
        "rules": [
          {
            "type": "dependency",
            "files": [
              "**/package.json"
            ],
            "technology": "typescript",
            "kind": "language",
            "package": "typescript"
          },
          {
            "type": "file",
            "files": [
              "**/tsconfig.json"
            ],
            "technology": "typescript",
            "kind": "language",
            "declaration": "TypeScript project configuration"
          }
        ],
        "compatibility": {
          "groma": ">=0.5.0"
        }
      }
    }
  },
  "private": false
}
