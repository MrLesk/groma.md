{
  "name": "@groma/scanner-cobol",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "IBM fixed-format COBOL programs, local copybooks and bounded CALL evidence.",
  "groma": {
    "scanner": {
      "id": "cobol",
      "entry": "./src/index.ts",
      "include": ["**/*.[cC][bB][lL]", "**/*.[cC][oO][bB]", "**/*.[cC][pP][yY]"],
      "exclude": [],
      "discovery": {
        "technologies": ["cobol"],
        "rules": [{
          "type": "file",
          "files": ["**/*.[cC][bB][lL]", "**/*.[cC][oO][bB]"],
          "technology": "cobol",
          "kind": "language",
          "declaration": "COBOL source files; dialect and runtime configuration unverified"
        }],
        "compatibility": { "groma": ">=0.6.5" }
      }
    }
  },
  "dependencies": { "@groma/scanner": "workspace:*" }
}
