{
  "name": "@groma/scanner-cpp",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Experimental C++ source declarations, outlines and unresolved call evidence.",
  "groma": {
    "scanner": {
      "id": "cpp",
      "entry": "./src/index.ts",
      "include": [
        "**/*.cpp",
        "**/*.cc",
        "**/*.cxx",
        "**/*.C",
        "**/*.hpp",
        "**/*.hh",
        "**/*.hxx",
        "**/*.h",
        "**/*.ipp",
        "**/*.tpp"
      ],
      "exclude": [
        "build/",
        "cmake-build*/",
        "CMakeFiles/"
      ],
      "discovery": {
        "technologies": [
          "cpp"
        ],
        "rules": [
          {
            "type": "file",
            "files": [
              "**/*.cpp",
              "**/*.cc",
              "**/*.cxx",
              "**/*.C",
              "**/*.hpp",
              "**/*.hh",
              "**/*.hxx"
            ],
            "technology": "cpp",
            "kind": "language",
            "declaration": "C++ source; build configuration and preprocessor branches unverified"
          }
        ],
        "compatibility": {
          "groma": ">=0.6.6"
        }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "tree-sitter-cpp": "0.23.4"
  }
}
