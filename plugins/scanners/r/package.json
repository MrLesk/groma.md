{
  "name": "@groma/scanner-r",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Experimental R source inventory and named function outlines through tree-sitter.",
  "groma": {
    "scanner": {
      "id": "r",
      "entry": "./src/index.ts",
      "include": ["**/*.[Rr]", "**/DESCRIPTION"],
      "exclude": ["tests/", "test/", "revdep/", "renv/", "packrat/", "RcppExports.R"],
      "discovery": {
        "technologies": ["r"],
        "rules": [{
          "type": "file",
          "files": ["**/*.[Rr]"],
          "technology": "r",
          "kind": "language",
          "declaration": "R source; syntax analysis without executing R"
        }],
        "compatibility": { "groma": ">=0.6.6" }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@davisvaughan/tree-sitter-r": "1.3.0"
  }
}
